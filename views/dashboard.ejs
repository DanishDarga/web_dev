        <% layout('boilerplate') %>
        <main class="main-content">
            <header class="dashboard-header">
                <h1>Welcome, <%= username %>!</h1>
                <!-- Header actions can be added here if needed -->
            </header>

            <section class="summary-cards">
                <div class="card">
                    <h3>Total Balance</h3>
                    <% const isBalanceNegative = typeof totalBalance !== 'undefined' && totalBalance < 0; %>
                    <p class="card-value <%= isBalanceNegative ? 'negative-amount' : 'positive-amount' %>">
                        <%= isBalanceNegative ? '-' : '' %>$<%= typeof totalBalance !== 'undefined' ? Math.abs(totalBalance).toFixed(2) : '0.00' %>
                    </p>
                    <p class="card-change <%= isBalanceNegative ? 'negative' : 'positive' %>">
                        <%= isBalanceNegative ? '▼' : '▲' %> this month
                    </p>
                </div>
                <div class="card">
                    <h3>Monthly Income</h3>
                    <p class="card-value positive-amount">$<%= typeof monthlyIncome !=='undefined' ? monthlyIncome.toFixed(2) : '0.00' %>
                    </p>
                    <p class="card-change positive">▲ this month</p>
                </div>
                <div class="card">
                    <h3>Monthly Expenses</h3>
                    <p class="card-value negative-amount">$<%= typeof monthlyExpenses !=='undefined' ? monthlyExpenses.toFixed(2) : '0.00' %>
                    </p>
                    <p class="card-change negative">▼ this month</p>
                </div>
                <div class="card">
                    <h3>Savings Goal</h3>
                    <p class="card-value">0% Complete</p>
                    <div class="progress-bar-container">
                        <div class="progress-bar" style="width: 1%;"></div>
                    </div>
                </div>
            </section>

            <section class="charts-section">
                <div class="chart-container" id="line-chart">
                    <h3 class="chart-title">Income vs. Expenses</h3>
                    <div class="canvas-wrapper">
                        <canvas id="myLineChart"></canvas>
                    </div>
                </div>
                <div class="chart-container" id="pie-chart">
                    <h3 class="chart-title">Expense Categories</h3>
                    <div class="canvas-wrapper">
                        <canvas id="myPieChart"></canvas>
                    </div>
                </div>
            </section>


            <section class="transaction-list">
                <h2>Recent Transactions</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (transactions && transactions.length> 0) { %>
                            <% transactions.forEach(function(tx) { %>
                                <tr>
                                    <td>
                                        <%= tx.date ? new Date(tx.date).toLocaleDateString('en-US') : 'N/A' %>
                                    </td>
                                    <td>
                                        <%= tx.item || tx.description || 'N/A' %>
                                    </td>
                                    <td>
                                        <%= tx.category %>
                                    </td>
                                    <td
                                        class="<%= tx.type && tx.type.toLowerCase() === 'income' ? 'positive-amount' : 'negative-amount' %>">
                                        <%= tx.type && tx.type.toLowerCase()==='income' ? '+' : '-' %>$<%=
                                                tx.amount.toFixed(2) %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4">No transactions found.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </section>

            <section class="danger-zone card mt-5">
                <h2 class="text-danger">Delete Data</h2>
                <p>Resetting your account will permanently delete all of your transaction data. This action cannot be undone.</p>
                <form action="/reset-data" method="POST" onsubmit="return confirm('Are you absolutely sure you want to delete all your transaction data? This action cannot be undone.');">
                    <button type="submit" class="btn btn-danger">Reset All Data</button>
                </form>
            </section>
        </main>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Data from EJS
            const chartData = {
                pie: {
                    labels: <%- JSON.stringify(pieChartLabels || []) %>,
                    data: <%- JSON.stringify(pieChartData || []) %>
                },
                line: {
                    labels: <%- JSON.stringify(lineChartLabels || []) %>,
                    incomeData: <%- JSON.stringify(lineChartIncomeData || []) %>,
                    expenseData: <%- JSON.stringify(lineChartExpenseData || []) %>
                }
            };

            // Line Chart: Income vs. Expenses
            const lineCtx = document.getElementById('myLineChart');
            if (lineCtx) {
                new Chart(lineCtx, {
                    type: 'line',
                    data: {
                        labels: chartData.line.labels,
                        datasets: [{
                            label: 'Income',
                            data: chartData.line.incomeData,
                            borderColor: 'rgba(75, 192, 192, 1)',
                            backgroundColor: 'rgba(75, 192, 192, 0.2)',
                            fill: true,
                            tension: 0.4
                        }, {
                            label: 'Expenses',
                            data: chartData.line.expenseData,
                            borderColor: 'rgba(255, 99, 132, 1)',
                            backgroundColor: 'rgba(255, 99, 132, 0.2)',
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { ticks: { autoSkip: true, maxRotation: 0, } },
                            y: { beginAtZero: true }
                        },
                        plugins: { legend: { position: 'top', } }
                    }
                });
            }

            // Pie Chart: Expense Categories
            const pieCtx = document.getElementById('myPieChart');
            if (pieCtx && chartData.pie.data.length > 0) {
                new Chart(pieCtx, {
                    type: 'pie',
                    data: {
                        labels: chartData.pie.labels,
                        datasets: [{
                            label: 'Expenses by Category',
                            data: chartData.pie.data,
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.8)', 'rgba(54, 162, 235, 0.8)',
                                'rgba(255, 206, 86, 0.8)', 'rgba(75, 192, 192, 0.8)',
                                'rgba(153, 102, 255, 0.8)', 'rgba(255, 159, 64, 0.8)'
                            ],
                            borderColor: 'rgba(255, 255, 255, 0.7)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'top' } } // Moves legend to prevent overlap
                    }
                });
            }
        });
    </script>