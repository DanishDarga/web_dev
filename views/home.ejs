<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FinanceFlow</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/style/home.css" />
</head>

<body>
    <header class="header">
        <a href="#" class="logo">
            <i class="fas fa-dollar-sign logo-icon"></i>
            FinanceFlow
        </a>
        <div>
            <a href="/signup" class="header-button">Sign in</a>
            <a href="/login" class="header-button">Log in</a>
        </div>
    </header>
    <div class="container">
        <main class="hero-section">
            <h1 class="hero-title">
                Take Control of Your<br />
                <span class="hero-title-highlight">Financial Future</span>
            </h1>
            <p class="hero-subtitle">
                Smart budgeting, expense tracking, and financial insights all in one
                beautiful, intuitive platform. Make informed decisions and achieve
                your financial goals.
            </p>
            <a href="#" class="hero-button">
                Start Managing Money
                <span class="hero-button-arrow">&rarr;</span>
            </a>
        </main>

        <section class="features-section">
            <div class="feature-card">
                <div class="feature-icon-container green">
                    <i class="fas fa-chart-line feature-icon green"></i>
                </div>
                <h3 class="feature-title">Smart Tracking</h3>
                <p class="feature-description">
                    Automatically categorize and track your expenses with intelligent
                    insights that help you understand your spending patterns.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-container blue">
                    <i class="fas fa-clock feature-icon blue"></i>
                </div>
                <h3 class="feature-title">Visual Budgets</h3>
                <p class="feature-description">
                    Create and monitor budgets with beautiful charts and real-time
                    progress tracking to stay on top of your financial goals.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-container purple">
                    <i class="fas fa-shield-alt feature-icon purple"></i>
                </div>
                <h3 class="feature-title">Secure & Private</h3>
                <p class="feature-description">
                    Your financial data is protected with bank-level security. We never
                    share your personal information with third parties.
                </p>
            </div>
        </section>
    </div>

    <footer class="footer">
        FinanceFlow - Smart personal finance management made simple
    </footer>
</body>

</html>