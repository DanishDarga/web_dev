<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services - Finance Flow</title>
    <link rel="stylesheet" href="../style/s.css">
    <link rel="stylesheet" href="../style/sidebar.css"> <!-- Sidebar shared CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2 class="logo">💰 Finance Flow</h2>
            <nav>
                <ul>
                    <li><a href="/dashboard">🏠 Dashboard</a></li>
                    <li><a href="/managefinance">💳 Transactions</a></li>
                    <li class="active"><a href="/services">⚙ Services</a></li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header>
                <h1>Available Services</h1>
                <div>
                    <a href="/dashboard" class="btn btn-secondary mr-0">Back to Dashboard</a>
                    <a href="/dashboard" class="btn btn-info ml-0">Home</a>
                </div>

            </header>

            <section class="services-grid">
                <!-- Example Services -->
                <div class="service-card">
                    <div class="icon">💳</div>
                    <h3>Credit Card</h3>
                    <p>Pay and manage your credit card bills securely.</p>
                    <button class="service-btn">Manage</button>
                </div>

                <div class="service-card">
                    <div class="icon">⚡</div>
                    <h3>Utility Bills</h3>
                    <p>Pay your electricity, water, and gas bills in one place.</p>
                    <button class="service-btn">Pay Now</button>
                </div>

                <div class="service-card">
                    <div class="icon">📱</div>
                    <h3>Mobile Recharge</h3>
                    <p>Recharge prepaid numbers or pay postpaid bills instantly.</p>
                    <button class="service-btn">Recharge</button>
                </div>

                <div class="service-card">
                    <div class="icon">📈</div>
                    <h3>Investments</h3>
                    <p>Track and grow your savings with smart investment tools.</p>
                    <button class="service-btn">Explore</button>
                </div>

                <div class="service-card">
                    <div class="icon">🏠</div>
                    <h3>Loan Management</h3>
                    <p>Keep track of EMIs and manage your loans with ease.</p>
                    <button class="service-btn">View Loans</button>
                </div>

                <div class="service-card">
                    <div class="icon">🛡</div>
                    <h3>Insurance</h3>
                    <p>Secure your future with health, life, and vehicle insurance.</p>
                    <button class="service-btn">Get Covered</button>
                </div>
            </section>
        </main>
    </div>
</body>

</html>