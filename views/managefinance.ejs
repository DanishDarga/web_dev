<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Transactions - FinanceFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../style/sidebar.css"> <!-- shared sidebar CSS -->
</head>

<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2 class="logo">💰 Finance Flow</h2>
            <nav>
                <ul>
                    <li><a href="/dashboard">🏠 Dashboard</a></li>
                    <li class="active"><a href="/transactions">💳 Transactions</a></li>
                    <li><a href="/services">⚙ Services</a></li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="container-fluid my-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1>Manage Transactions</h1>
                    <div>
                        <a href="/dashboard" class="btn btn-secondary mr-0">Back to Dashboard</a>
                        <a href="/dashboard" class="btn btn-info ml-0">Home</a>
                    </div>


                </div>

                <!-- Add Transaction Form -->
                <div class="card mb-5">
                    <div class="card-header">
                        <h3>Add New Transaction</h3>
                    </div>
                    <div class="card-body">
                        <form action="/transactions" method="POST">
                            <div class="mb-3">
                                <label for="type" class="form-label">Type</label>
                                <select class="form-select" id="type" name="type" required>
                                    <option value="expense">Expense</option>
                                    <option value="income">Income</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="item" class="form-label">Item / Description</label>
                                <input type="text" class="form-control" id="item" name="item"
                                    placeholder="e.g., Weekly shopping" required>
                            </div>
                            <div class="mb-3" id="category-field">
                                <label for="category" class="form-label">Category</label>
                                <input type="text" class="form-control" id="category" name="category"
                                    placeholder="e.g., Groceries" required>
                            </div>
                            <div class="mb-3">
                                <label for="amount" class="form-label">Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="amount" name="amount"
                                        placeholder="0.00" step="0.01" min="0" required>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Add Transaction</button>
                        </form>
                    </div>
                </div>

                <!-- Transactions Table -->
                <div class="card">
                    <div class="card-header">
                        <h3>All Transactions</h3>
                    </div>
                    <div class="card-body">
                        <% if (transactions && transactions.length> 0) { %>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th scope="col">Date</th>
                                            <th scope="col">Description</th>
                                            <th scope="col">Category</th>
                                            <th scope="col">Type</th>
                                            <th scope="col" class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% transactions.sort((a, b)=> new Date(b.date) - new
                                            Date(a.date)).forEach(function(tx) { %>
                                            <tr>
                                                <td>
                                                    <%= new Date(tx.date).toLocaleDateString('en-US') %>
                                                </td>
                                                <td>
                                                    <%= tx.item %>
                                                </td>
                                                <td>
                                                    <%= tx.category %>
                                                </td>
                                                <td>
                                                    <span
                                                        class="badge bg-<%= tx.type === 'income' ? 'success' : 'danger' %>">
                                                        <%= tx.type.charAt(0).toUpperCase() + tx.type.slice(1) %>
                                                    </span>
                                                </td>
                                                <td
                                                    class="text-end fw-bold <%= tx.type === 'income' ? 'text-success' : 'text-danger' %>">
                                                    <%= tx.type==='income' ? '+' : '-' %>$<%= tx.amount.toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                                <p class="text-center text-muted">No transactions have been added yet.</p>
                                <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const typeSelect = document.getElementById('type');
            const categoryField = document.getElementById('category-field');
            const categoryInput = document.getElementById('category');

            function toggleCategoryField() {
                if (typeSelect.value === 'income') {
                    categoryField.style.display = 'none';
                    categoryInput.removeAttribute('required');
                    categoryInput.value = 'Income'; // Set a default value to pass validation
                } else {
                    categoryField.style.display = 'block';
                    categoryInput.setAttribute('required', 'required');
                    categoryInput.value = '';
                }
            }

            // Run on page load to set initial state
            toggleCategoryField();

            // Add event listener for changes
            typeSelect.addEventListener('change', toggleCategoryField);
        });
    </script>
</body>

</html>