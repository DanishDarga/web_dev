<% layout('boilerplate') %>

        <!-- Main Content -->
        <main class="main-content">
            <div class="container-fluid my-4">
                <div class="mb-4">
                    <h1>All Transactions</h1>
                </div>

                <!-- Transactions Table -->
                <div class="card">
                    <div class="card-header">
                        All Transactions
                    </div>
                    <div class="card-body">
                        <% if (transactions && transactions.length> 0) { %>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th scope="col">Date</th>
                                            <th scope="col">Description</th>
                                            <th scope="col">Category</th>
                                            <th scope="col">Type</th>
                                            <th scope="col" class="text-end">Amount</th>
                                            <th scope="col" class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% transactions.forEach(function(tx) { %>
                                            <tr>
                                                <td>
                                                    <%= new Date(tx.date).toLocaleDateString('en-US') %>
                                                </td>
                                                <td>
                                                    <%= tx.item %>
                                                </td>
                                                <td>
                                                    <%= tx.category %>
                                                </td>
                                                <td>
                                                    <span
                                                        class="badge bg-<%= tx.type === 'income' ? 'success' : 'danger' %>">
                                                        <%= tx.type.charAt(0).toUpperCase() + tx.type.slice(1) %>
                                                    </span>
                                                </td>
                                                <td
                                                    class="text-end fw-bold <%= tx.type === 'income' ? 'text-success' : 'text-danger' %>">
                                                    <%= tx.type==='income' ? '+' : '-' %>$<%= tx.amount.toFixed(2) %>
                                                </td>
                                                <td class="text-center">
                                                    <a href="/transactions/<%= tx._id %>/edit"
                                                        class="btn btn-sm btn-warning me-1">Edit</a>
                                                    <form action="/transactions/<%= tx._id %>/delete" method="POST"
                                                        class="d-inline"
                                                        onsubmit="return confirm('Are you sure you want to delete this transaction?');">
                                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                                <p class="text-center text-muted">No transactions have been added yet.</p>
                                <% } %>
                    </div>
                </div>
            </div>
        </main>