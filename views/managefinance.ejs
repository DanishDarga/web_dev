<form action="/managefinance/addtransaction/:id" method="POST">
    <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <input type="text" class="form-control" id="category" name="category" placeholder="Enter category">
    </div>
    <div class="mb-3">
        <label for="item" class="form-label">Item</label>
        <input type="text" class="form-control" id="item" name="item" placeholder="Enter item">
    </div>
    <div class="mb-3">
        <label for="amount" class="form-label">Amount</label>
        <input type="number" class="form-control" id="amount" name="amount" placeholder="Enter expenditure amount">
    </div>

    <button type="submit" class="btn btn-primary">Add Expenditure</button>
</form>