<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FinanceABC - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="bg-light">

    <!-- Main Layout -->
    <div class="container-fluid">
        <div class="row">
            <!-- Content -->
            <div class="col-md-10 p-4">
                <h3>Personal Finance Tracker</h3>

                <!-- Add Transaction Form -->
                <div class="card mb-4">
                    <div class="card-header">Add Transaction</div>
                    <div class="card-body">
                        <form class="row g-3" action="/transactions" method="POST">
                            <div class="col-md-6">
                                <label for="type" class="form-label">Type</label>
                                <select id="type" name="type" class="form-select">
                                    <option value="Income">Income</option>
                                    <option value="Expense">Expense</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="amount" class="form-label">Price</label>
                                <input type="number" class="form-control" id="amount" name="amount" placeholder="0.00"
                                    step="0.01" required>
                            </div>
                            <div class="col-md-6">
                                <label for="category" class="form-label">Category</label>
                                <input type="text" class="form-control" id="category" name="category"
                                    placeholder="e.g. Food, Salary" required>
                            </div>
                            <div class="col-md-6">
                                <label for="description" class="form-label">Item</label>
                                <input type="text" class="form-control" id="description" name="description"
                                    placeholder="e.g. Monthly salary, groceries" required>
                            </div>
                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary">Add</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Expenditure Summary -->
                <div class="card mb-4">
                    <div class="card-header">Expenditure by Category</div>
                    <div class="card-body">
                        <% if (expenditureByCategory && expenditureByCategory.length> 0) { %>
                            <ul class="list-group">
                                <% expenditureByCategory.forEach(item=> { %>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <%= item._id %>
                                            <span class="badge bg-danger rounded-pill">₹<%= item.totalAmount.toFixed(2)
                                                    %></span>
                                    </li>
                                    <% }) %>
                            </ul>
                            <% } else { %>
                                <p class="text-center text-muted">No expenses recorded yet.</p>
                                <% } %>
                    </div>
                </div>

                <!-- Transactions Table -->
                <div class="card mb-4">
                    <div class="card-header">Recent Transactions</div>
                    <div class="card-body">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Category</th>
                                    <th>Item</th>
                                    <th>Amount (Price)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (transactions && transactions.length> 0) { %>
                                    <% transactions.forEach(transaction=> { %>
                                        <tr>
                                            <td>
                                                <%= new Date(transaction.date).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <%= transaction.type %>
                                            </td>
                                            <td>
                                                <%= transaction.category %>
                                            </td>
                                            <td>
                                                <%= transaction.description %>
                                            </td>
                                            <td>₹<%= transaction.amount.toFixed(2) %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="5" class="text-center">No transactions yet.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>

</html>