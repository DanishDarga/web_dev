<% layout('boilerplate') %>

        <!-- Main Content -->
        <main class="main-content">
            <div class="container-fluid my-4">
                <div class="mb-4">
                    <h1>Manage Transactions</h1>
                </div>

                <!-- Add Transaction Form -->
                <div class="card mb-5">
                    <div class="card-header">
                        Add New Transaction
                    </div>
                    <div class="card-body">
                        <form action="/transactions" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Type</label>
                                <!-- Hidden native select for form submission and JS compatibility -->
                                <select id="type" name="type" required style="position: absolute; height: 0; width: 0; opacity: 0;">
                                    <option value="expense" selected>Expense</option>
                                    <option value="income">Income</option>
                                </select>
                                <!-- Custom Dropdown UI -->
                                <div class="custom-select-container">
                                    <div class="selected-option">
                                        <span>Expense</span>
                                        <i class="fas fa-chevron-down custom-arrow"></i>
                                    </div>
                                    <div class="options-list">
                                        <div class="option" data-value="expense">Expense</div>
                                        <div class="option" data-value="income">Income</div>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="item" class="form-label">Item / Description</label>
                                <input type="text" class="form-control" id="item" name="item"
                                    placeholder="e.g., Weekly shopping" required>
                            </div>
                            <div class="mb-3" id="category-field">
                                <label for="category" class="form-label">Category</label>
                                <input type="text" class="form-control" id="category" name="category"
                                    placeholder="e.g., Groceries" required>
                            </div>
                            <div class="mb-3">
                                <label for="amount" class="form-label">Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="amount" name="amount"
                                        placeholder="0.00" step="0.01" min="0" required>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Add Transaction</button>
                        </form>
                    </div>
                </div>

                <!-- Transactions Table -->
                <div class="card">
                    <div class="card-header">
                        All Transactions
                    </div>
                    <div class="card-body">
                        <% if (transactions && transactions.length> 0) { %>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th scope="col">Date</th>
                                            <th scope="col">Description</th>
                                            <th scope="col">Category</th>
                                            <th scope="col">Type</th>
                                            <th scope="col" class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% transactions.sort((a, b)=> new Date(b.date) - new
                                            Date(a.date)).forEach(function(tx) { %>
                                            <tr>
                                                <td>
                                                    <%= new Date(tx.date).toLocaleDateString('en-US') %>
                                                </td>
                                                <td>
                                                    <%= tx.item %>
                                                </td>
                                                <td>
                                                    <%= tx.category %>
                                                </td>
                                                <td>
                                                    <span
                                                        class="badge bg-<%= tx.type === 'income' ? 'success' : 'danger' %>">
                                                        <%= tx.type.charAt(0).toUpperCase() + tx.type.slice(1) %>
                                                    </span>
                                                </td>
                                                <td
                                                    class="text-end fw-bold <%= tx.type === 'income' ? 'text-success' : 'text-danger' %>">
                                                    <%= tx.type==='income' ? '+' : '-' %>$<%= tx.amount.toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                                <p class="text-center text-muted">No transactions have been added yet.</p>
                                <% } %>
                    </div>
                </div>
            </div>
        </main>
    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        #category-field {
            transition: all 0.35s ease-in-out;
            overflow: hidden;
            max-height: 150px;
            margin-top: 0;
            /* Ample height for the field and its label */
        }

        #category-field.hidden {
            max-height: 0;
            opacity: 0;
            padding-top: 0;
            padding-bottom: 0;
            /* Hides from screen readers and tabbing */
            visibility: hidden;
            margin-top: -1rem; /* Counteract the margin of the element above */
        }
        
        /* --- Custom Select Dropdown --- */
        .custom-select-container {
            position: relative;
            cursor: pointer;
            user-select: none;
        }

        .selected-option {
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            padding: 0.5rem 0.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #fff;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }

        .custom-select-container.open .selected-option {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, .25);
        }

        .custom-arrow {
            transition: transform 0.3s ease;
        }

        .custom-select-container.open .custom-arrow {
            transform: rotate(180deg);
        }

        .options-list {
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            background: white;
            border: 1px solid #dee2e6;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, .15);
            border-radius: 0.375rem; /* Rounded corners for the dropdown box */
            z-index: 10;
            
            /* Smooth transition */
            visibility: hidden;
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
        }

        .custom-select-container.open .options-list {
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }

        .option {
            padding: 0.5rem 0.75rem;
        }

        .option:hover {
            background-color: #f8f9fa;
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const typeSelect = document.getElementById('type');
            const categoryField = document.getElementById('category-field');
            const categoryInput = document.getElementById('category');

            // --- Custom Select Logic ---
            const customSelectContainer = document.querySelector('.custom-select-container');
            const selectedOptionDisplay = customSelectContainer.querySelector('.selected-option');
            const customOptions = customSelectContainer.querySelectorAll('.option');

            selectedOptionDisplay.addEventListener('click', (e) => {
                e.stopPropagation();
                customSelectContainer.classList.toggle('open');
            });

            customOptions.forEach(option => {
                option.addEventListener('click', () => {
                    // Update the display
                    selectedOptionDisplay.querySelector('span').textContent = option.textContent;
                    // Update the hidden native select's value
                    typeSelect.value = option.getAttribute('data-value');
                    // Manually trigger a 'change' event on the native select
                    // This ensures the category field logic still works
                    typeSelect.dispatchEvent(new Event('change'));
                });
            });

            // Close dropdown when clicking outside
            window.addEventListener('click', () => {
                if (customSelectContainer.classList.contains('open')) {
                    customSelectContainer.classList.remove('open');
                }
            });

            // --- Original Category Field Logic ---
    
            function toggleCategoryField() {
                if (typeSelect.value === 'income') {
                    categoryField.classList.add('hidden');
                    categoryInput.removeAttribute('required');
                    categoryInput.value = 'Income'; // Set a default value to pass validation
                } else {
                    categoryField.classList.remove('hidden');
                    categoryInput.setAttribute('required', 'required');
                    categoryInput.value = '';
                }
            }
    
            // Run on page load to set initial state
            toggleCategoryField();
    
            // Add event listener for changes
            typeSelect.addEventListener('change', toggleCategoryField);
        });
    </script>
</html>